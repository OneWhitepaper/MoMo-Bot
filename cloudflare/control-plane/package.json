{
  "name": "@openmausbot/control-plane",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "^26.2.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "scripts": {
    "check": "pnpm types && tsc -p tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types --strict-vars=false --config wrangler.local.jsonc worker-configuration.d.ts",
    "types:check": "wrangler types --strict-vars=false --check --config wrangler.local.jsonc worker-configuration.d.ts",
    "dry-run": "wrangler deploy --dry-run --config wrangler.local.jsonc"
  }
}
