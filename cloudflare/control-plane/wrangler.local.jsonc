{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "momobot-control-plane-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "BETTER_AUTH_URL": "https://localhost:8787",
    "EMAIL_FROM": "noreply@momobot.test",
    "ALLOWED_ORIGINS": "https://app.momobot.test",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    "CLOUDFLARE_ZONE_ID": "00000000000000000000000000000000",
    "COMPANION_HOST_SUFFIX": "momobot.test",
    "CLOUDFLARE_ENDPOINT_ACCOUNTS": "",
    "OMB_TUNNEL_LIMIT": "1000",
    "OMB_DNS_RECORD_LIMIT": "1000",
    "OMB_TUNNEL_RECLAIM": "observe",
    "OMB_TUNNEL_OFFLINE_RECLAIM_DAYS": "21",
    "OMB_TUNNEL_RECLAIM_PREVIEW_DAYS": "",
    "OMB_CLEANUP_SWEEP_LIMIT": "3"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "CLOUDFLARE_API_TOKEN"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "momobot-control-plane-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ]
}
